{
  "id": "tgClaudeShared01",
  "name": "Telegram to Claude Bridge (shared n8n)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "placeholder-uuid"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ (() => { const allowed = ['REPLACE_WITH_TELEGRAM_USER_ID']; return allowed.includes(String($json.message.chat.id)) && allowed.includes(String($json.message.from.id)); })() }}",
              "value2": true
            }
          ]
        }
      },
      "id": "2",
      "name": "Verify Allowlist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/execute",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ command: $json.message.text }) }}",
        "options": {}
      },
      "id": "3",
      "name": "Send to Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        650,
        280
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Claude Bridge API Key"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
        "text": "={{$json.output}}",
        "additionalFields": {}
      },
      "id": "4",
      "name": "Send Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        850,
        280
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Verify Allowlist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Allowlist": {
      "main": [
        [
          {
            "node": "Send to Claude",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Claude": {
      "main": [
        [
          {
            "node": "Send Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "pinData": {},
  "versionId": "1",
  "triggerCount": 1,
  "tags": []
}
