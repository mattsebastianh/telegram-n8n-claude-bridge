# ==========================================
# Bundled n8n (Mode B only; ignore this section if you use your own n8n)
# ==========================================
# Host port for the n8n UI (change it if 5680 is already in use)
N8N_HOST_PORT=5680
# Public HTTPS hostname of your Cloudflare Tunnel (trailing slash required)
WEBHOOK_URL=https://your-tunnel-hostname.example.com/
GENERIC_TIMEZONE=America/Chicago

# ==========================================
# Security Allowlist
# ==========================================
# Comma-separated list of Telegram Chat IDs allowed to execute commands
TELEGRAM_ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID,ANOTHER_ID

# ==========================================
# Local Bridge API Configuration
# ==========================================
BRIDGE_PORT=3000
# Generate a strong random string for this (e.g., openssl rand -hex 32)
BRIDGE_API_KEY=YOUR_SECURE_RANDOM_API_KEY

# Note: The Telegram Bot Token should be stored inside n8n's Credential Manager,
# NOT directly in this file, to prevent leaking via exported workflows.

# =
# Cloudflare Tunnel (optional, docker-compose --profile tunnel)
# =
# Token from Cloudflare Zero Trust > Networks > Tunnels. Keep it private.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
