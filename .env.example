# ==========================================
# Bundled n8n (Mode B only; ignore this section if you use your own n8n)
# ==========================================
# Host port for the n8n UI (change it if 5680 is already in use)
N8N_HOST_PORT=5680
# Public HTTPS hostname of your Cloudflare Tunnel (trailing slash required)
WEBHOOK_URL=https://your-tunnel-hostname.example.com/
GENERIC_TIMEZONE=America/Chicago

# ==========================================
# Security Allowlist
# ==========================================
# Comma-separated numeric Telegram user IDs allowed to send commands
TELEGRAM_ALLOWED_USER_IDS=YOUR_TELEGRAM_USER_ID,ANOTHER_ID

# ==========================================
# Local Bridge API Configuration
# ==========================================
BRIDGE_PORT=3000
# Optional: URL n8n uses to reach the bridge (scripts/render-workflow.js). Default: http://host.docker.internal:<BRIDGE_PORT>
# BRIDGE_API_URL=http://host.docker.internal:3000
# Dedicated folder Claude works in (required; not your home directory)
BRIDGE_CWD=/path/to/your/claude-workspace
# Tools Claude may use without asking (headless mode has nobody to approve).
# Read/edit only by default. Add Bash to let Telegram messages run shell commands in BRIDGE_CWD.
BRIDGE_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write
# Each Claude call is stopped after this many milliseconds
BRIDGE_TIMEOUT_MS=300000
# Optional settings (defaults shown where they apply):
# BRIDGE_SYSTEM_PROMPT=You are answering through a Telegram chat. Keep replies concise, in plain text, and under 3500 characters.
# BRIDGE_ALLOWED_IPS=          # extra source IPs the bridge accepts (localhost is always allowed)
# BRIDGE_DEBUG=1               # echo Claude's stderr in the bridge terminal
# CLAUDE_CMD=claude            # command to run instead of claude
# Required. At least 24 characters; the bridge refuses placeholders. Generate one: openssl rand -hex 32
BRIDGE_API_KEY=YOUR_SECURE_RANDOM_API_KEY

# Note: The Telegram Bot Token should be stored inside n8n's Credential Manager,
# NOT directly in this file, to prevent leaking via exported workflows.

# ==========================================
# Cloudflare Tunnel (Mode B, optional: docker-compose --profile tunnel)
# ==========================================
# Token from Cloudflare Zero Trust > Networks > Tunnels. Keep it private.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
